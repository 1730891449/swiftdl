{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftDL",
  "version": "0.4.0",
  "identifier": "com.swiftdl.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5179",
    "beforeDevCommand": { "script": "npm run dev", "cwd": ".." }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SwiftDL",
        "width": 1120,
        "height": 700,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#101114",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "高速下载管理器，支持断点续传",
    "longDescription": "SwiftDL 使用多连接分段下载提升速度，支持在崩溃或断网后继续下载，并自动接管浏览器下载。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../extension/": "extension/",
      "gen/extension-firefox/": "extension-firefox/"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
